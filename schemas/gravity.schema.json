{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsmy.local/schemas/gravity.schema.json",
  "title": "TSMY – gravity (public derived data)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "provenance": {
      "$ref": "https://tsmy.local/schemas/common.schema.json#/$defs/provenance"
    },
    "sceneId": {
      "const": "gravity"
    },
    "year": {
      "const": 2026
    },
    "artists": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "plays": {
            "type": "integer",
            "minimum": 0
          },
          "minutes": {
            "type": "number",
            "minimum": 0
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "artworkAsset": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "plays",
          "minutes",
          "rank"
        ]
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceArtistId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
          },
          "targetArtistId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
          },
          "sharedSessions": {
            "type": "integer",
            "minimum": 0
          },
          "definition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceArtistId",
          "targetArtistId",
          "sharedSessions",
          "definition"
        ]
      },
      "minItems": 0
    },
    "orbitMonths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
          },
          "artists": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artistId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
                },
                "minutes": {
                  "type": "number",
                  "minimum": 0
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "artistId",
                "minutes",
                "rank"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "month",
          "artists"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "provenance",
    "sceneId",
    "year",
    "artists",
    "connections"
  ]
}
