{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsmy.local/schemas/capsule.schema.json",
  "title": "TSMY – capsule (public derived data)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "provenance": {
      "$ref": "https://tsmy.local/schemas/common.schema.json#/$defs/provenance"
    },
    "sceneId": {
      "const": "capsule"
    },
    "years": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2018,
            "maximum": 2026
          },
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "memoryId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
          },
          "coverAsset": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "year",
          "headline"
        ]
      },
      "minItems": 1
    },
    "hypothesisFragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
          },
          "eyebrow": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "emphasis": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "end": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "eyebrow",
          "title",
          "emphasis",
          "start",
          "end"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "schemaVersion",
    "provenance",
    "sceneId",
    "years",
    "hypothesisFragments"
  ]
}
