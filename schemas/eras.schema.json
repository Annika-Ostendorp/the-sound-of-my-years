{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsmy.local/schemas/eras.schema.json",
  "title": "TSMY – eras (public derived data)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "provenance": {
      "$ref": "https://tsmy.local/schemas/common.schema.json#/$defs/provenance"
    },
    "sceneId": {
      "const": "eras"
    },
    "years": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 2018,
        "maximum": 2026
      },
      "minItems": 1
    },
    "months": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
          },
          "observed": {
            "type": "boolean"
          },
          "coverageDays": {
            "type": "integer",
            "minimum": 0
          },
          "totalMinutes": {
            "type": "number",
            "minimum": 0
          },
          "artistMinutes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artistId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{1,80}$"
                },
                "minutes": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "artistId",
                "minutes"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "month",
          "observed",
          "coverageDays",
          "totalMinutes",
          "artistMinutes"
        ]
      },
      "minItems": 1
    },
    "timeLens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowMonths": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "windowMonths",
        "method"
      ]
    },
    "dejaVu": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dateA": {
            "type": "string",
            "format": "date"
          },
          "dateB": {
            "type": "string",
            "format": "date"
          },
          "cosineSimilarity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dateA",
          "dateB",
          "cosineSimilarity",
          "method"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "provenance",
    "sceneId",
    "years",
    "months"
  ]
}
