{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsmy.local/schemas/media.schema.json",
  "title": "TSMY – media (public derived data)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "provenance": {
      "$ref": "https://tsmy.local/schemas/common.schema.json#/$defs/editorialProvenance"
    },
    "sceneId": {
      "const": "media"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "https://tsmy.local/schemas/common.schema.json#/$defs/mediaRef"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "provenance",
    "sceneId",
    "assets"
  ]
}
